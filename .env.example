# ─────────────────────────────────────────────────
# PiKaraoke Docker Configuration
# ─────────────────────────────────────────────────
# Copy this file to .env and adjust the values.
#
#   cp .env.example .env
#   docker compose up -d
#
# ─────────────────────────────────────────────────

# REQUIRED: Path to the directory containing your karaoke songs
SONGS_PATH=/home/shaddad/Documents/pikaraoke-songs

# Display for VLC video output and splash screen (default: :0)
DISPLAY=:0

# UID of the host user (for PulseAudio socket access)
HOST_UID=1000

# URL shown on the QR code / splash screen
QR_URL=http://myvikaraoke.local

# Hide IP address on splash screen
HIDE_IP=false

# Download quality (true = 1080p best quality, false = mp4 standard)
HIGH_QUALITY=true

# Port mappings (change if defaults conflict)
WEB_PORT=5000
WS_PORT=80
